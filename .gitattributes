# Keep line endings exactly as the files need them, whatever the person cloning has configured.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.pyw text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.ico binary
